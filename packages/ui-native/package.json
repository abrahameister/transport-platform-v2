{
  "name": "@transport-platform/ui-native",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76.0"
  },
  "dependencies": {
    "@transport-platform/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@transport-platform/test-utils": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.72.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.0.0"
  }
}
