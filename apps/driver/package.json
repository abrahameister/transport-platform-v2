{
  "name": "@transport-platform/driver",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform all",
    "export": "expo export --platform all",
    "doctor": "expo-doctor",
    "lint": "eslint \"app/**/*.{ts,tsx}\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@transport-platform/design-tokens": "workspace:*",
    "@transport-platform/supabase": "workspace:*",
    "@transport-platform/ui-native": "workspace:*",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.8",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "expo-doctor": "^1.12.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "@transport-platform/design-tokens",
          "@transport-platform/supabase",
          "@transport-platform/ui-native"
        ]
      }
    }
  }
}
