{
  "name": "transport-platform-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.0.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:bootstrap-users": "node scripts/bootstrap-dev-users.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml,css}\"",
    "check": "pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo clean && rimraf node_modules .turbo dist apps/*/.next apps/*/.expo apps/*/dist packages/*/dist",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "driver:doctor": "pnpm dlx expo-doctor@1.12.0 apps/driver",
    "driver:export": "pnpm --filter driver export --platform all",
    "security:scan": "node scripts/security-scan.js",
    "adversarial:scan": "node scripts/adversarial-scan.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.62.0",
    "@supabase/supabase-js": "^2.111.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "supabase": "2.111.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
